{
    "name": "mitydigital/sitemapamic",
    "description": "A powerful and performant XML sitemap generator for Statamic.",
    "license": "MIT",
    "authors": [
        {
            "name": "Marty Friedel"
        }
    ],
    "autoload": {
        "psr-4": {
            "MityDigital\\Sitemapamic\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MityDigital\\Sitemapamic\\Tests\\": "tests"
        }
    },
    "require": {
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "pestphp/pest": "^4.7",
        "laravel/pint": "^1.24",
        "spatie/laravel-ray": "^1.33",
        "statamic/eloquent-driver": "^5.13",
        "statamic/ssg": "^4.2"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Sitemapamic",
            "description": "A powerful and performant XML sitemap generator for Statamic."
        },
        "laravel": {
            "providers": [
                "MityDigital\\Sitemapamic\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": [
            "./vendor/bin/pint"
        ],
        "test": [
            "php -d memory_limit=-1 -d max_execution_time=0 ./vendor/bin/pest"
        ]
    }
}
